{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // ensure compiled files go to dist and use node-next module for compatibility
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "NodeNext",
    "incremental": false,
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*.spec.ts"
  ],
  "include": [
    "src/**/*.ts"
  ]
}